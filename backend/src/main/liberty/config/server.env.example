# Plantilla de variables de entorno del backend (equivalente a un ".env"). Sin secretos reales.
# Copiar como "server.env" en este mismo directorio (ignorado por git): Liberty lo lee al arrancar
# y lo expone como variables de entorno del servidor. Liberty NO lee un ".env" por si solo.
#
# Otras formas de entregar los valores:
#   - exportarlas en el shell antes de ./mvnw liberty:dev
#   - bootstrap.properties (ver bootstrap.properties.example; tiene MAS precedencia que el entorno)
#
# Mapeo con server.xml: <variable name="db.host"/> se resuelve con DB_HOST
# (mayusculas, puntos -> guion bajo). Igual para db.port, db.name, db.user, db.password, db.sslmode.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full  (Supabase exige SSL: usar require)
DB_SSLMODE=prefer

# Opcional: sobreescribir cuentas y tasas de contabilidad.properties
# (clave en mayusculas, puntos -> guion bajo), por ejemplo:
# CUENTA_INVENTARIO=1105
# IVA_TASA=0.13
