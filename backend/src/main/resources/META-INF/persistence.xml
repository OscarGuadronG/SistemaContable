<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Unidad principal: la usa la aplicacion dentro de Liberty (JTA). -->
    <persistence-unit name="contablePU" transaction-type="JTA">
        <jta-data-source>jdbc/ContableDS</jta-data-source>
        <class>com.sistemacontable.entity.EntidadBase</class>
        <class>com.sistemacontable.entity.Almacen</class>
        <class>com.sistemacontable.entity.Cliente</class>
        <class>com.sistemacontable.entity.Compra</class>
        <class>com.sistemacontable.entity.CompraDetalle</class>
        <class>com.sistemacontable.entity.Cuenta</class>
        <class>com.sistemacontable.entity.Departamento</class>
        <class>com.sistemacontable.entity.Empleado</class>
        <class>com.sistemacontable.entity.Existencias</class>
        <class>com.sistemacontable.entity.Kardex</class>
        <class>com.sistemacontable.entity.KardexDetalle</class>
        <class>com.sistemacontable.entity.Lote</class>
        <class>com.sistemacontable.entity.Partida</class>
        <class>com.sistemacontable.entity.PartidaDetalle</class>
        <class>com.sistemacontable.entity.Planilla</class>
        <class>com.sistemacontable.entity.PlanillaDetalle</class>
        <class>com.sistemacontable.entity.Producto</class>
        <class>com.sistemacontable.entity.Proveedor</class>
        <class>com.sistemacontable.entity.Tercero</class>
        <class>com.sistemacontable.entity.TipoProducto</class>
        <class>com.sistemacontable.entity.UnidadMedida</class>
        <class>com.sistemacontable.entity.Venta</class>
        <class>com.sistemacontable.entity.VentaDetalle</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- El esquema vive en la base de datos (ver docs/esquema-bd.sql); la aplicacion nunca lo crea. -->
            <property name="eclipselink.ddl-generation" value="none"/>
        </properties>
    </persistence-unit>

    <!-- Unidad para consolas JPA de IDE (RESOURCE_LOCAL). No se usa en el servidor.
         La conexion NO se escribe aqui: se entrega al arrancar con propiedades de sistema,
         por ejemplo:
           -Djakarta.persistence.jdbc.url=jdbc:postgresql://localhost:5432/postgres
           -Djakarta.persistence.jdbc.user=postgres
           -Djakarta.persistence.jdbc.password=<clave> -->
    <persistence-unit name="consolePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <class>com.sistemacontable.entity.EntidadBase</class>
        <class>com.sistemacontable.entity.Almacen</class>
        <class>com.sistemacontable.entity.Cliente</class>
        <class>com.sistemacontable.entity.Compra</class>
        <class>com.sistemacontable.entity.CompraDetalle</class>
        <class>com.sistemacontable.entity.Cuenta</class>
        <class>com.sistemacontable.entity.Departamento</class>
        <class>com.sistemacontable.entity.Empleado</class>
        <class>com.sistemacontable.entity.Existencias</class>
        <class>com.sistemacontable.entity.Kardex</class>
        <class>com.sistemacontable.entity.KardexDetalle</class>
        <class>com.sistemacontable.entity.Lote</class>
        <class>com.sistemacontable.entity.Partida</class>
        <class>com.sistemacontable.entity.PartidaDetalle</class>
        <class>com.sistemacontable.entity.Planilla</class>
        <class>com.sistemacontable.entity.PlanillaDetalle</class>
        <class>com.sistemacontable.entity.Producto</class>
        <class>com.sistemacontable.entity.Proveedor</class>
        <class>com.sistemacontable.entity.Tercero</class>
        <class>com.sistemacontable.entity.TipoProducto</class>
        <class>com.sistemacontable.entity.UnidadMedida</class>
        <class>com.sistemacontable.entity.Venta</class>
        <class>com.sistemacontable.entity.VentaDetalle</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="eclipselink.target-database" value="PostgreSQL"/>
            <property name="eclipselink.weaving" value="false"/>
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
        </properties>
    </persistence-unit>
</persistence>
